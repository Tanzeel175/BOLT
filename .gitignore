# ==========================================
# BOLT - Git Ignore Rules (Confidential & Secrets)
# ==========================================

# 1. Environment variables, API keys & Secrets
.env
.env.*
*.env
*.env.local
*.env.production
*.env.staging
*.env.development
!.env.example
secrets/
*.pem
*.key
*.token
*.cert
*.crt
credentials.json
client_secret*.json

# 2. Local Databases & Persistent State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
!data/.gitkeep

# 3. Application Logs & Telemetry
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. Virtual Environments & Packages
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. Operating System & IDE Specific
@AutomationLog.txt
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
