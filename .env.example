# BOLT - AI Assistant Environment Configuration

# Primary AI Provider: "gemini", "openai", or "mock"
BOLT_AI_PROVIDER=gemini

# Google Gemini API
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (or OpenAI-compatible providers like Groq, OpenRouter, Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# General Settings
BOLT_TEMPERATURE=0.7
BOLT_MAX_TOKENS=2048
BOLT_LOG_LEVEL=INFO

