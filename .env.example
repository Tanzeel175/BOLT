# BOLT - AI Assistant Environment Configuration

# Primary AI Provider: "ollama" (offline), "nebius", "custom", "gemini", "openai", or "mock"
BOLT_AI_PROVIDER=ollama

# Local Ollama (Recommended & Offline)
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_SIZE=2048
OLLAMA_CPU_THREADS=8

# Nebius Token Factory (Official Cloud Inference & Fine-Tuning)
# Get your API key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Google Gemini API
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Custom / Any Model (Groq, DeepSeek, OpenRouter, Mistral, LM Studio)
CUSTOM_PROVIDER_NAME=Custom / Any Model
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://api.groq.com/openai/v1
CUSTOM_MODEL=llama-3.3-70b-versatile

# General Settings
BOLT_TEMPERATURE=0.7
BOLT_MAX_TOKENS=2048
BOLT_LOG_LEVEL=INFO
